# Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# MySQL/TiDB-compatible database required by drizzle/schema.ts
# Neon PostgreSQL is NOT compatible with the current mysql2 + drizzle-orm/mysql-core stack.
DATABASE_URL=mypublicdatabaseurl

# Auth / OAuth
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
VITE_APP_ID=CHANGE_ME
OAUTH_SERVER_URL=https://api.manus.im
OWNER_OPEN_ID=CHANGE_ME
OWNER_NAME=GunsMasterPro

# Public URLs and SEO
CANONICAL_ORIGIN=mysitedomainurl
SITE_NAME=mysitename

# Manus Storage / built-in services, only if used by the deployment target
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Stockage des médias.
# "local" : les visuels sont écrits dans le volume persistant et servis par
# l'application sur /media/*. Aucune dépendance à Manus ni à S3.
# "forge" : délégation à Manus Forge/S3, servi sur /manus-storage/*.
MEDIA_STORAGE_MODE=local
LOCAL_MEDIA_DIR=/app/data/media

# Jeton du point d'import massif de médias (POST /api/media-import/*).
# Sans valeur, la route est désactivée. Générer avec : openssl rand -hex 32
MEDIA_IMPORT_TOKEN=

# Optional public contact settings are stored in the database, not hard-coded here.
