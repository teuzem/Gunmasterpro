# Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# MySQL/TiDB-compatible database required by drizzle/schema.ts
# Neon PostgreSQL is NOT compatible with the current mysql2 + drizzle-orm/mysql-core stack.
DATABASE_URL=mysql://gunsmasterpro:CHANGE_ME@db:3306/gunsmasterpro

# Auth / OAuth
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
VITE_APP_ID=CHANGE_ME
OAUTH_SERVER_URL=https://api.manus.im
OWNER_OPEN_ID=CHANGE_ME
OWNER_NAME=GunsMasterPro

# Public URLs and SEO
CANONICAL_ORIGIN=https://gunmaster-pro.com
SITE_NAME=GunsMasterPro

# Manus Storage / built-in services, only if used by the deployment target
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional public contact settings are stored in the database, not hard-coded here.
