node_modules
.pnpm-store
dist
# Ancrage à la racine : « data/ » sans « / » retirait aussi server/data/, dont
# le snapshot catalogue et la taxonomie sont importés au build par
# server/catalog.ts. Leur absence fait échouer « pnpm build ».
/data/
.git
.github
.env
.env.*
!.env.example
.manus-logs
coverage
.DS_Store
*.log
screenshots
terminal_full_output

# 992 Mo d'originaux déjà téléversés dans le bucket de stockage. Le build ne
# les utilise pas : Vite sert les publics depuis client/public (voir
# publicDir dans vite.config.ts). Sans cette exclusion, `COPY . .` envoie tout
# le contexte au démon Docker, ce qui ralentit fortement le build et peut le
# faire échouer sur un petit VPS.
public/
# Les images de catalogue DOIVENT être dans l'image pour être servies depuis
# /app/data/media/ par le serveur Node.
!public/images categories
!public/images hero section
!public/pakarms_catalog_export/images
